# Copy to /etc/apple-calendar-mcp.env (referenced by the systemd unit) and fill in.
# Keep this file readable only by the service account: chmod 600.

# --- iCloud CalDAV (required) ---
ICLOUD_USERNAME=you@icloud.com
# App-specific password from https://appleid.apple.com (NOT your Apple ID password)
ICLOUD_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# --- Transport ---
MCP_TRANSPORT=http
MCP_HOST=0.0.0.0
MCP_PORT=8420

# --- Local dev on your own Mac (Phase 1) ---
# Trust same-machine callers (127.0.0.1) without Tailscale. Turn this ON while
# running locally, OFF once you move to the tailnet.
ALLOW_LOOPBACK=1

# --- Tailscale identity auth (Phase 2) ---
# Comma-separated allowed device hostnames and/or login emails.
# If left unset, ANY device that resolves on your tailnet is allowed.
TS_ALLOWED=my-laptop,my-phone,my-desktop
# Alternatively, one identity per line in a file:
# TS_ALLOWLIST_FILE=/etc/apple-calendar-mcp.allow
# TAILSCALE_SOCKET=/var/run/tailscale/tailscaled.sock

# --- Optional ---
# CALENDAR_TZ=America/New_York      # default: system /etc/localtime
# DEFAULT_CALENDAR=Home             # name or id used when a tool omits calendar_id
